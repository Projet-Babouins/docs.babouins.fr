---
// Remplace le composant <Head> de Starlight (voir `components` dans astro.config.mjs) :
// le <head> d'origine, plus de quoi mettre à jour la page en douceur quand le site
// est reconstruit. Trois empreintes sont écrites dans la page au build ; le script
// lib/live-update.ts les compare à celles de la version en ligne.
import { createHash } from 'node:crypto';
import Default from '@astrojs/starlight/components/Head.astro';
import { BUILD_ID } from '../lib/build-id';

const { entry, sidebar } = Astro.locals.starlightRoute;
const hash = (value: unknown) => createHash('sha256').update(JSON.stringify(value)).digest('hex').slice(0, 16);

type Entry = (typeof sidebar)[number];
const outline = (entries: Entry[]): unknown[] =>
	entries.map((item) => (item.type === 'link' ? [item.label, item.href] : [item.label, outline(item.entries)]));
---

<Default><slot /></Default>
<meta name="babouins:build" content={BUILD_ID} />
<meta name="babouins:page" content={hash([entry.data, entry.body])} />
<meta name="babouins:nav" content={hash(outline(sidebar))} />
{/* Page « introuvable » : elle se rechargera seule si l'adresse finit par exister (cours tout juste créé). */}
{entry.id === '404' && <meta name="babouins:missing" content="1" />}

<script>
	import '../lib/live-update';
</script>

<style is:global>
	@keyframes live-update-in {
		from {
			opacity: 0.35;
		}
	}
	.live-updated {
		animation: live-update-in 0.4s ease-out;
	}
	.live-update-notice {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: calc(100vw - 2rem);
		padding: 0.6rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-left: 4px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		box-shadow: var(--sl-shadow-md);
		animation: live-update-in 0.4s ease-out;
	}
	.live-update-notice button {
		padding: 0.25rem 0.75rem;
		border: 0;
		border-radius: 0.375rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	@media (prefers-reduced-motion: reduce) {
		.live-updated,
		.live-update-notice {
			animation: none;
		}
	}
</style>
